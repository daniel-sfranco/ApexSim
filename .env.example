POSTGRES_USER=apexsim
POSTGRES_PASSWORD=apexsim
POSTGRES_DB=apexsim

# Porta do banco no host. Mude se a 5433 já estiver ocupada na sua máquina.
POSTGRES_HOST_PORT=5433

# Token da API do Kaggle (kaggle.com > Settings > API > Create Token).
# Só é necessário para `make kaggle`. Nunca commite o valor real.
KAGGLE_API_TOKEN=
